<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Candles.Views.FirstPage"
             Title="FirstPage">
    <!--- get age from field, calculate age in ten years and display the amount of candles-->
        <!-- Name and Age field with a button -->
        <Grid Padding="20" RowDefinitions="*, Auto" >
        <ScrollView>
            <Grid RowDefinitions="auto,auto">
                <Label x:Name="ResultLabel" Grid.Row="0" Grid.Column="0" FontSize="Large" VerticalOptions="Start"/>
                <StackLayout Grid.Row="1" x:Name="LayoutFields" Spacing="8" HorizontalOptions="CenterAndExpand" />
            </Grid>
        </ScrollView>
        <Grid Grid.Row="1" RowDefinitions="*, *, *" ColumnDefinitions="*,*" VerticalOptions="End">
                <Label Text="Name:" Grid.Row="0" Grid.Column="0" FontSize="Large" />
                <Entry Grid.Row="0" Grid.Column="1" />
                <Label Text="Age:" Grid.Row="1" Grid.Column="0" FontSize="Large"/>
                <Entry x:Name="AgeEntry" Grid.Row="1" Grid.Column="1" />
                <Button Clicked="OnSubmitClicked" Text="Submit" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"/>
            </Grid>
        </Grid>
</ContentPage>